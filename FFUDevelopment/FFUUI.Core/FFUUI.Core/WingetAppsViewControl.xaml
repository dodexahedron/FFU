<UserControl x:Class="FFUUI.Core.WingetAppsViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="WingetAppsView"
             DataContext="{Binding ElementName=WingetAppsView, Path=Items}">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="0,10,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ListView x:Name="AppListView"
                SelectionMode="Extended"
                Grid.Column="0"
                Margin="0,0,10,0">
        <ListView.View>
          <GridView>

            <GridViewColumn Width="80">
              <GridViewColumn.Header>
                <CheckBox Content="All"
                          IsChecked="{Binding AllSelected, Mode=OneWay}" />
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Name" Width="200">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Source" Width="120">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Arch" Width="80">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Architecture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Version" Width="120">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Additional Exit Codes" Width="180">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding AdditionalExitCodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Ignore Exit Codes" Width="140">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IgnoreNonZeroExitCodes, Mode=TwoWay}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <GridViewColumn Header="Download Status" Width="240">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid>

                    <Border CornerRadius="4"
                            Background="#EEE"
                            Height="22"
                            VerticalAlignment="Center" />

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Height="22"
                                 VerticalAlignment="Center">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                          <Setter Property="Foreground" Value="#4A90E2" />
                          <Style.Triggers>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Pending">
                              <Setter Property="Foreground" Value="#AAAAAA" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Downloading">
                              <Setter Property="Foreground" Value="#4A90E2" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Completed">
                              <Setter Property="Foreground" Value="#4CAF50" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Failed">
                              <Setter Property="Foreground" Value="#E53935" />
                            </DataTrigger>

                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Text="{Binding DownloadStatus, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="Black" />

                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               FontSize="14"
                               FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="" />
                          <Style.Triggers>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Pending">
                              <Setter Property="Text" Value="⏳" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Downloading">
                              <Setter Property="Text" Value="⬇" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Completed">
                              <Setter Property="Text" Value="✔" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DownloadState}" Value="Failed">
                              <Setter Property="Text" Value="✖" />
                            </DataTrigger>

                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>

          </GridView>
        </ListView.View>
      </ListView>

      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Orientation="Vertical"
                  Margin="10,0,0,0">

        <Button Content="Move Up"
                Margin="0,0,0,10"
                Padding="10,2" />

        <Button Content="Move Down"
                Margin="0,0,0,10"
                Padding="10,2" />

        <Button Content="Move to Top"
                Margin="0,0,0,10"
                Padding="10,2" />

        <Button Content="Move to Bottom"
                Padding="10,2" />

      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Count, StringFormat=Total: {0}}" />
      <TextBlock Margin="20,0,0,0" Text="{Binding SelectedCount, StringFormat=Selected: {0}}" />
      <Button Content="Remove Highlighted" Margin="40,0,0,0" Padding="10,2"/>
      <Button Content="Remove All Highlighted" Margin="10,0,0,0" Padding="10,2" />
    </StackPanel>

  </Grid>
</UserControl>
