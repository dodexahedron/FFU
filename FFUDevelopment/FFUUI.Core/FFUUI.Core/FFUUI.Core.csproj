<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>FFUUI.Core</AssemblyTitle>
    <AssemblyName>FFUUI.Core</AssemblyName>
    <RootNamespace>FFUUI.Core</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="All" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Documents" />
    <Using Include="System.Windows.Media" />
  </ItemGroup>
</Project>